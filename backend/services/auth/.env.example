PORT=8001
MONGODB_URI=mongodb://127.0.0.1:27017/cortexai-auth
REDIS_URL=redis://localhost:6379

# Firebase Admin credentials for deployments without a local service-account JSON file.
# Store the private key only in your local .env or hosting provider secrets.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
